+"""NCh433 Tabla 5.1 — maximum response modification factors R and Ro.
+
+Transcribed from *NCh433.Of1996 Mod.2009 (DS 61-2011)*, Tabla 5.1 "Valores
+máximos de los factores de modificación de la respuesta" (p. 27), together
+with its three footnotes.
+
+The table is organised as two structural-system families — ``Pórticos`` and
+``Muros y sistemas arriostrados`` — each subdivided by structural material,
+plus a catch-all row for anything that fits neither. ``R`` is the factor used
+by the static method (§6.2) and by the ``Cmax`` limit of Tabla 6.4; ``Ro`` is
+the factor that feeds ``R*`` in the modal spectral method (Eq. 6-10).
+
+Footnote 3 leaves ``Ro`` undefined for the unclassifiable row, because modal
+spectral analysis is not permitted there at all. That cell is ``None`` rather
+than a fabricated number, and asking for it raises.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+
+from ...core.exceptions import InvalidInput, TableLookupError
+from ...core.references import ClauseRef
+from ...core.reports import Report, ReportItem
+
+__all__ = [
+    "TABLE_5_1",
+    "ResponseFactors",
+    "StructuralSystem",
+    "resolve_R",
+    "resolve_Ro",
+    "response_factors",
+]
+
+STANDARD = "NCh433"
+EDITION = "Of1996 Mod.2009 (DS 61-2011)"
+
+TABLE_5_1_REF = ClauseRef(
+    standard=STANDARD,
+    edition=EDITION,
+    clause="5.7.1",
+    table="5.1",
+    description="Valores maximos de los factores de modificacion de la respuesta",
+)
+
+#: Footnote 1) of Tabla 5.1.
+FOOTNOTE_1 = (
+    "Los valores de Tabla 5.1 para acero estructural y hormigon armado suponen "
+    "el cumplimiento de lo establecido en 5.3.3 (Anexo B) y 5.3.4 "
+    "respectivamente."
+)
+
+#: Footnote 2) of Tabla 5.1 — definition of "criterio A".
+FOOTNOTE_2 = (
+    "Criterio A: los muros de hormigon armado deben tomar en cada piso, el 50% "
+    "del esfuerzo de corte del piso, como minimo."
+)
+
+#: Footnote 3) of Tabla 5.1 — why Ro is undefined for the unclassifiable row.
+FOOTNOTE_3 = (
+    "No procede el uso del analisis modal espectral para este tipo de "
+    "estructuracion o material. Por lo tanto, no se establece un valor para Ro."
+)
+
+#: The two system families named in the first column of Tabla 5.1.
+PORTICOS = "Porticos"
+MUROS = "Muros y sistemas arriostrados"
+SIN_CLASIFICAR = "Sin clasificar"
+
+
+class StructuralSystem(str, Enum):
+    """A row of NCh433 Tabla 5.1.
+
+    Examples
+    --------
+    >>> StructuralSystem.PORTICO_ACERO_SMF.R
+    7.0
+    >>> StructuralSystem.PORTICO_ACERO_SMF.Ro
+    11.0
+    >>> StructuralSystem.OTRO.Ro is None
+    True
+    """
+
+    # -- Porticos -----------------------------------------------------------
+    PORTICO_ACERO_OMF = "portico_acero_omf"
+    PORTICO_ACERO_IMF = "portico_acero_imf"
+    PORTICO_ACERO_SMF = "portico_acero_smf"
+    PORTICO_ACERO_STMF = "portico_acero_stmf"
+    PORTICO_HORMIGON_ARMADO = "portico_hormigon_armado"
+
+    # -- Muros y sistemas arriostrados --------------------------------------
+    MURO_ACERO_OCBF = "muro_acero_ocbf"
+    MURO_ACERO_SCBF = "muro_acero_scbf"
+    MURO_ACERO_EBF = "muro_acero_ebf"
+    MURO_HORMIGON_ARMADO = "muro_hormigon_armado"
+    MURO_HORMIGON_ALBANILERIA_CONFINADA_CRITERIO_A = (
+        "muro_hormigon_albanileria_confinada_criterio_a"
+    )
+    MURO_HORMIGON_ALBANILERIA_CONFINADA_SIN_CRITERIO_A = (
+        "muro_hormigon_albanileria_confinada_sin_criterio_a"
+    )
+    MURO_MADERA = "muro_madera"
+    MURO_ALBANILERIA_CONFINADA = "muro_albanileria_confinada"
+    MURO_ALBANILERIA_ARMADA_HUECOS_LLENOS = "muro_albanileria_armada_huecos_llenos"
+    MURO_ALBANILERIA_ARMADA_HUECOS_SIN_LLENAR = (
+        "muro_albanileria_armada_huecos_sin_llenar"
+    )
+
+    # -- Catch-all ----------------------------------------------------------
+    OTRO = "otro"
+
+    @property
+    def factors(self) -> ResponseFactors:
+        """The full Tabla 5.1 row for this system."""
+        return TABLE_5_1[self.value]
+
+    @property
+    def R(self) -> float:
+        """Maximum response modification factor ``R`` (Tabla 5.1)."""
+        return self.factors.R
+
+    @property
+    def Ro(self) -> float | None:
+        """Maximum response modification factor ``Ro``, or ``None``.
+
+        ``None`` only for :attr:`OTRO`, where footnote 3 of Tabla 5.1 declines
+        to establish a value because modal spectral analysis is not permitted.
+        """
+        return self.factors.Ro
+
+
+@dataclass(frozen=True, slots=True)
+class ResponseFactors:
+    """One row of Tabla 5.1: the maximum ``R`` and ``Ro`` for a system.
+
+    Parameters
+    ----------
+    system
+        Key of the row, the value of a :class:`StructuralSystem` member.
+    family
+        First column of the table: ``Porticos``, ``Muros y sistemas
+        arriostrados``, or ``Sin clasificar``.
+    material
+        Second column: the structural material and sub-row description, as
+        printed.
+    R
+        Maximum response modification factor for the static method (§6.2) and
+        for the ``Cmax`` limit of Tabla 6.4.
+    Ro
+        Maximum base response modification factor for the modal spectral
+        method (Eq. 6-10). ``None`` where the standard establishes no value.
+    notes
+        Footnotes of Tabla 5.1 that apply to this row.
+    """
+
+    system: str
+    family: str
+    material: str
+    R: float
+    Ro: float | None
+    notes: tuple[str, ...] = ()
+
+    @property
+    def modal_spectral_analysis_permitted(self) -> bool:
+        """Whether §6.3 modal spectral analysis may be used (footnote 3)."""
+        return self.Ro is not None
+
+    @property
+    def description(self) -> str:
+        """``"family — material"``, as the printed table reads."""
+        return f"{self.family} — {self.material}"
+
+    def require_Ro(self) -> float:
+        """``Ro``, or raise if Tabla 5.1 establishes no value for this row."""
+        if self.Ro is None:
+            raise InvalidInput(
+                f"NCh433 Tabla 5.1 establishes no Ro for {self.system!r} "
+                f"({self.description}). {FOOTNOTE_3}"
+            )
+        return self.Ro
+
+    def report(self) -> Report:
+        """A citation-carrying record of this Tabla 5.1 row."""
+        return Report(
+            title=f"NCh433 Tabla 5.1 — {self.description}",
+            items=(
+                ReportItem("Sistema", self.family, "Sistema estructural", "",
+                           TABLE_5_1_REF),
+                ReportItem("Material", self.material, "Material estructural", "",
+                           TABLE_5_1_REF),
+                ReportItem("R", self.R,
+                           "Factor de modificacion de la respuesta (maximo)", "",
+                           TABLE_5_1_REF),
+                ReportItem("Ro", self.Ro,
+                           "Factor de modificacion de la respuesta Ro (maximo)", "",
+                           TABLE_5_1_REF),
+            ),
+            notes=self.notes,
+        )
+
+    def __str__(self) -> str:
+        return self.report().to_text()
+
+
+def _row(
+    system: StructuralSystem,
+    family: str,
+    material: str,
+    R: float,
+    Ro: float | None,
+    *notes: str,
+) -> tuple[str, ResponseFactors]:
+    return system.value, ResponseFactors(
+        system=system.value,
+        family=family,
+        material=material,
+        R=R,
+        Ro=Ro,
+        notes=notes,
+    )
+
+
+#: Tabla 5.1 — maximum R and Ro, keyed by :class:`StructuralSystem` value.
+TABLE_5_1: dict[str, ResponseFactors] = dict(
+    (
+        # -- Porticos -------------------------------------------------------
+        _row(StructuralSystem.PORTICO_ACERO_OMF, PORTICOS,
+             "Acero estructural: a) Marcos corrientes (OMF)", 4.0, 5.0,
+             FOOTNOTE_1),
+        _row(StructuralSystem.PORTICO_ACERO_IMF, PORTICOS,
+             "Acero estructural: b) Marcos intermedios (IMF)", 5.0, 6.0,
+             FOOTNOTE_1),
+        _row(StructuralSystem.PORTICO_ACERO_SMF, PORTICOS,
+             "Acero estructural: c) Marcos especiales (SMF)", 7.0, 11.0,
+             FOOTNOTE_1),
+        _row(StructuralSystem.PORTICO_ACERO_STMF, PORTICOS,
+             "Acero estructural: d) Marco de vigas enrejadas (STMF)", 6.0, 10.0,
+             FOOTNOTE_1),
+        _row(StructuralSystem.PORTICO_HORMIGON_ARMADO, PORTICOS,
+             "Hormigon armado", 7.0, 11.0, FOOTNOTE_1),
+        # -- Muros y sistemas arriostrados ----------------------------------
+        _row(StructuralSystem.MURO_ACERO_OCBF, MUROS,
+             "Acero estructural: a) Marcos concentricos corrientes (OCBF)",
+             3.0, 5.0, FOOTNOTE_1),
+        _row(StructuralSystem.MURO_ACERO_SCBF, MUROS,
+             "Acero estructural: b) Marcos concentricos especiales (SCBF)",
+             5.5, 8.0, FOOTNOTE_1),
+        _row(StructuralSystem.MURO_ACERO_EBF, MUROS,
+             "Acero estructural: c) Marcos excentricos (EBF)", 6.0, 10.0,
+             FOOTNOTE_1),
+        _row(StructuralSystem.MURO_HORMIGON_ARMADO, MUROS,
+             "Hormigon armado", 7.0, 11.0, FOOTNOTE_1),
+        _row(StructuralSystem.MURO_HORMIGON_ALBANILERIA_CONFINADA_CRITERIO_A,
+             MUROS,
+             "Hormigon armado y albanileria confinada: si se cumple el criterio A",
+             6.0, 9.0, FOOTNOTE_1, FOOTNOTE_2),
+        _row(StructuralSystem.MURO_HORMIGON_ALBANILERIA_CONFINADA_SIN_CRITERIO_A,
+             MUROS,
+             "Hormigon armado y albanileria confinada: si no se cumple el "
+             "criterio A",
+             4.0, 4.0, FOOTNOTE_1, FOOTNOTE_2),
+        _row(StructuralSystem.MURO_MADERA, MUROS, "Madera", 5.5, 7.0),
+        _row(StructuralSystem.MURO_ALBANILERIA_CONFINADA, MUROS,
+             "Albanileria confinada", 4.0, 4.0),
+        _row(StructuralSystem.MURO_ALBANILERIA_ARMADA_HUECOS_LLENOS, MUROS,
+             "Albanileria armada: de bloques de hormigon o unidades de "
+             "geometria similar en las que se llenan todos los huecos, y "
+             "albanileria de muros doble chapa",
+             4.0, 4.0),
+        _row(StructuralSystem.MURO_ALBANILERIA_ARMADA_HUECOS_SIN_LLENAR, MUROS,
+             "Albanileria armada: de ladrillos ceramicos tipo rejilla con y sin "
+             "relleno de huecos y albanileria de bloques de hormigon o unidades "
+             "de geometria similar en que no se llenan todos los huecos",
+             3.0, 3.0),
+        # -- Catch-all ------------------------------------------------------
+        _row(StructuralSystem.OTRO, SIN_CLASIFICAR,
+             "Cualquier tipo de estructuracion o material que no pueda ser "
+             "clasificado en alguna de las categorias anteriores",
+             2.0, None, FOOTNOTE_3),
+    )
+)
+
+
+def response_factors(system: StructuralSystem | str) -> ResponseFactors:
+    """Look up the Tabla 5.1 row for a structural system.
+
+    Parameters
+    ----------
+    system
+        A :class:`StructuralSystem` member, or its string value.
+
+    Raises
+    ------
+    TableLookupError
+        ``system`` is not a row of Tabla 5.1.
+
+    Examples
+    --------
+    >>> response_factors("muro_acero_scbf").R
+    5.5
+    >>> response_factors("muro_acero_scbf").Ro
+    8.0
+    """
+    try:
+        key = StructuralSystem(system)
+    except ValueError:
+        raise TableLookupError(
+            f"structural system {system!r} is not a row of NCh433 Tabla 5.1. "
+            f"Defined: {[s.value for s in StructuralSystem]}."
+        ) from None
+    return TABLE_5_1[key.value]
+
+
+def _resolve(
+    name: str,
+    given: float | None,
+    tabulated: float | None,
+    row: ResponseFactors | None,
+) -> float:
+    if given is None:
+        if row is None:
+            raise InvalidInput(
+                f"Provide {name} explicitly, or a structural system so that it "
+                f"can be read from NCh433 Tabla 5.1."
+            )
+        if tabulated is None:
+            raise InvalidInput(
+                f"NCh433 Tabla 5.1 establishes no {name} for {row.system!r} "
+                f"({row.description}). {FOOTNOTE_3}"
+            )
+        return tabulated
+    if given <= 0.0:
+        raise InvalidInput(f"{name} must be positive.")
+    if row is not None:
+        if tabulated is None:
+            raise InvalidInput(
+                f"NCh433 Tabla 5.1 establishes no {name} for {row.system!r} "
+                f"({row.description}), so {given:g} cannot be used. {FOOTNOTE_3}"
+            )
+        if given > tabulated:
+            raise InvalidInput(
+                f"{name} = {given:g} exceeds the maximum {tabulated:g} that "
+                f"NCh433 Tabla 5.1 allows for {row.system!r} "
+                f"({row.description}). Tabla 5.1 gives maximum values; "
+                f"§5.7.2 and §5.7.3 may require a smaller one still."
+            )
+    return float(given)
+
+
+def resolve_Ro(
+    Ro: float | None = None,
+    system: StructuralSystem | str | None = None,
+) -> float:
+    """Return ``Ro``, checked against the Tabla 5.1 maximum.
+
+    Supply ``system`` to read ``Ro`` straight from the table, ``Ro`` to use a
+    value of your own, or both to have the value checked against the tabulated
+    maximum.
+
+    Raises
+    ------
+    InvalidInput
+        Neither argument was given, ``Ro`` is not positive, ``Ro`` exceeds the
+        tabulated maximum, or the row establishes no ``Ro`` (footnote 3).
+    TableLookupError
+        ``system`` is not a row of Tabla 5.1.
+
+    Examples
+    --------
+    >>> resolve_Ro(system="portico_hormigon_armado")
+    11.0
+    >>> resolve_Ro(9.0, "portico_hormigon_armado")
+    9.0
+    """
+    row = None if system is None else response_factors(system)
+    return _resolve("Ro", Ro, None if row is None else row.Ro, row)
+
+
+def resolve_R(
+    R: float | None = None,
+    system: StructuralSystem | str | None = None,
+) -> float:
+    """Return ``R``, checked against the Tabla 5.1 maximum.
+
+    The ``R`` counterpart of :func:`resolve_Ro`. ``R`` is defined for every
+    row of the table, including the unclassifiable one.
+
+    Examples
+    --------
+    >>> resolve_R(system="muro_madera")
+    5.5
+    """
+    row = None if system is None else response_factors(system)
+    return _resolve("R", R, None if row is None else row.R, row)
