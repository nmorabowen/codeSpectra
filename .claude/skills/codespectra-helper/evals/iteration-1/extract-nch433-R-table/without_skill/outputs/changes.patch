+class TestTabla5_1:
+    @pytest.mark.parametrize(("system", "R", "Ro"), TABLA_5_1_AS_PRINTED)
+    def test_values_as_printed(self, system: str, R: float, Ro: float | None) -> None:
+        row = response_factors(system)
+        assert row.R == pytest.approx(R)
+        if Ro is None:
+            assert row.Ro is None
+        else:
+            assert row.Ro == pytest.approx(Ro)
+
+    def test_table_covers_every_enum_member(self) -> None:
+        assert set(TABLE_5_1) == {s.value for s in StructuralSystem}
+
+    def test_table_has_sixteen_rows(self) -> None:
+        assert len(TABLE_5_1) == len(TABLA_5_1_AS_PRINTED)
+
+    def test_enum_and_string_lookup_agree(self) -> None:
+        assert (
+            response_factors(StructuralSystem.MURO_ACERO_SCBF)
+            is response_factors("muro_acero_scbf")
+        )
+
+    def test_enum_shortcuts(self) -> None:
+        assert StructuralSystem.PORTICO_ACERO_SMF.R == pytest.approx(7.0)
+        assert StructuralSystem.PORTICO_ACERO_SMF.Ro == pytest.approx(11.0)
+
+    @pytest.mark.parametrize("system", [s for s in StructuralSystem if s.Ro is not None])
+    def test_Ro_never_below_R(self, system: StructuralSystem) -> None:
