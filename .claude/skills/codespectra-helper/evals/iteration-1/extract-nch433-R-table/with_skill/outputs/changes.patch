+"""NCh433 Tabla 5.1 — maximum response modification factors R and Ro.
+
+Transcribed from NCh433.Of1996 Mod.2009 (DS 61-2011), page 27, cross-checked
+between an ``-table`` and a ``-layout`` extraction of the source PDF.
+
+Two factors are printed side by side and they are *not* interchangeable:
+
+``R``
+    Used by the static method, Eq. 6-2, ``C = 2.75 S Ao / (g R) * (T'/T*)**n``.
+``Ro``
+    Used by the modal spectral method, feeding Eq. 6-10,
+    ``R*(T*) = 1 + T* / (0.10 To + T*/Ro)``.
+
+The values are **maxima** (§5.7.1, and the table's own caption). An engineer
+may adopt a smaller factor; adopting a larger one is not permitted, which is
+what :func:`check_R` and :func:`check_Ro` enforce.
+
+The final row — anything that cannot be classified — has ``R = 2`` and *no*
+``Ro``: footnote 3 forbids modal spectral analysis for it altogether. That
+cell is stored as ``None`` and raises rather than returning a plausible
+number.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+from ...core.exceptions import InvalidInput, TableLookupError
+from ...core.references import ClauseRef
+from ...core.reports import Report, ReportItem
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+
+__all__ = [
+    "EDITION",
+    "STANDARD",
+    "STRUCTURAL_SYSTEMS",
+    "TABLA_5_1_FOOTNOTES",
+    "StructuralSystem",
+    "check_R",
+    "check_Ro",
+    "clause_ref",
+    "structural_system",
+    "structural_system_keys",
+]
+
+STANDARD = "NCh433"
+EDITION = "Of1996 Mod.2009 (DS 61-2011)"
+
+
+def clause_ref(section: str, description: str, **kw: str) -> ClauseRef:
+    """A :class:`ClauseRef` into NCh433 for ``section``."""
+    return ClauseRef(standard=STANDARD, edition=EDITION, clause=section,
+                     description=description, **kw)
+
+
+#: Footnotes printed beneath Tabla 5.1, transcribed without accents so the
+#: rendered report survives a cp1252 console.
+TABLA_5_1_FOOTNOTES: dict[str, str] = {
+    "1": "Los valores indicados en esta tabla para acero estructural y hormigon "
+         "armado suponen el cumplimiento de lo establecido en 5.3.3 (Anexo B) y "
+         "5.3.4 respectivamente.",
+    "2": "Criterio A: los muros de hormigon armado deben tomar en cada piso, el "
+         "50% del esfuerzo de corte del piso, como minimo.",
+    "3": "No procede el uso del analisis modal espectral para este tipo de "
+         "estructuracion o material. Por lo tanto, no se establece un valor "
+         "para Ro.",
+}
+
+_TABLE_REF = clause_ref("5.7.1", "Valores maximos de los factores de "
+                                 "modificacion de la respuesta", table="5.1")
+
+
+@dataclass(frozen=True, slots=True)
+class StructuralSystem:
+    """One row of Tabla 5.1.
+
+    Parameters
+    ----------
+    key
+        Stable ASCII lookup key.
+    system
+        The *Sistema estructural* column.
+    material
+        The *Material estructural* column, as printed.
+    R
+        Maximum response modification factor for the static method (Eq. 6-2).
+    Ro
+        Maximum response modification factor for the modal spectral method
+        (Eq. 6-10). ``None`` where the standard establishes no value.
+    footnotes
+        Keys into :data:`TABLA_5_1_FOOTNOTES` that apply to this row.
+    """
+
+    key: str
+    system: str
+    material: str
+    R: float
+    Ro: float | None
+    footnotes: tuple[str, ...] = ()
+
+    @property
+    def label(self) -> str:
+        """Human-readable ``system - material``."""
+        return f"{self.system} - {self.material}"
+
+    @property
+    def modal_spectral_permitted(self) -> bool:
+        """Whether NCh433 establishes an ``Ro`` for this system."""
+        return self.Ro is not None
+
+    @property
+    def ref(self) -> ClauseRef:
+        """Citation for this row."""
+        return _TABLE_REF
+
+    def require_Ro(self) -> float:
+        """``Ro`` for this system, or raise if the standard establishes none."""
+        if self.Ro is None:
+            raise InvalidInput(
+                f"NCh433 Tabla 5.1 establishes no Ro for {self.key!r} "
+                f"({self.label}). " + TABLA_5_1_FOOTNOTES["3"] +
+                " Use the static method with R = "
+                f"{self.R:g} instead."
+            )
+        return self.Ro
+
+    def notes(self) -> tuple[str, ...]:
+        """Footnote text applying to this row, in printed order."""
+        return tuple(TABLA_5_1_FOOTNOTES[k] for k in self.footnotes)
+
+    def report(self) -> Report:
+        """A citation-carrying record of this row."""
+        items = [
+            ReportItem("Sistema", self.system, "Sistema estructural", "",
+                       self.ref),
+            ReportItem("Material", self.material, "Material estructural", "",
+                       self.ref),
+            ReportItem("R", self.R,
+                       "Factor de modificacion de la respuesta (analisis "
+                       "estatico, Eq. 6-2), valor maximo", "", self.ref),
+            ReportItem("Ro", self.Ro,
+                       "Factor de modificacion de la respuesta (analisis modal "
+                       "espectral, Eq. 6-10), valor maximo", "", self.ref),
+        ]
+        return Report(
+            title=f"NCh433 Tabla 5.1 — {self.label}",
+            items=tuple(items),
+            notes=self.notes(),
+        )
+
+
+def _row(
+    key: str,
+    system: str,
+    material: str,
+    R: float,
+    Ro: float | None,
+    footnotes: tuple[str, ...] = (),
+) -> tuple[str, StructuralSystem]:
+    return key, StructuralSystem(key, system, material, R, Ro, footnotes)
+
+
+_PORTICOS = "Porticos"
+_MUROS = "Muros y sistemas arriostrados"
+_OTRO = "Cualquier otra estructuracion o material"
+
+#: Tabla 5.1 — maximum R and Ro by structural system, in printed order.
+STRUCTURAL_SYSTEMS: dict[str, StructuralSystem] = dict((
+    _row("porticos_acero_omf", _PORTICOS,
+         "Acero estructural - a) Marcos corrientes (OMF)", 4.0, 5.0, ("1",)),
+    _row("porticos_acero_imf", _PORTICOS,
+         "Acero estructural - b) Marcos intermedios (IMF)", 5.0, 6.0, ("1",)),
+    _row("porticos_acero_smf", _PORTICOS,
+         "Acero estructural - c) Marcos especiales (SMF)", 7.0, 11.0, ("1",)),
+    _row("porticos_acero_stmf", _PORTICOS,
+         "Acero estructural - d) Marco de vigas enrejadas (STMF)",
+         6.0, 10.0, ("1",)),
+    _row("porticos_hormigon_armado", _PORTICOS, "Hormigon armado",
+         7.0, 11.0, ("1",)),
+    _row("muros_acero_ocbf", _MUROS,
+         "Acero estructural - a) Marcos concentricos corrientes (OCBF)",
+         3.0, 5.0, ("1",)),
+    _row("muros_acero_scbf", _MUROS,
+         "Acero estructural - b) Marcos concentricos especiales (SCBF)",
+         5.5, 8.0, ("1",)),
+    _row("muros_acero_ebf", _MUROS,
+         "Acero estructural - c) Marcos excentricos (EBF)", 6.0, 10.0, ("1",)),
+    _row("muros_hormigon_armado", _MUROS, "Hormigon armado", 7.0, 11.0, ("1",)),
+    _row("muros_hormigon_albanileria_criterio_a", _MUROS,
+         "Hormigon armado y albanileria confinada - Si se cumple el criterio A",
+         6.0, 9.0, ("1", "2")),
+    _row("muros_hormigon_albanileria_sin_criterio_a", _MUROS,
+         "Hormigon armado y albanileria confinada - Si no se cumple el "
+         "criterio A", 4.0, 4.0, ("1", "2")),
+    _row("muros_madera", _MUROS, "Madera", 5.5, 7.0),
+    _row("albanileria_confinada", _MUROS, "Albanileria confinada", 4.0, 4.0),
+    _row("albanileria_armada_bloques_llenos", _MUROS,
+         "Albanileria armada - De bloques de hormigon o unidades de geometria "
+         "similar en las que se llenan todos los huecos, y albanileria de "
+         "muros doble chapa", 4.0, 4.0),
+    _row("albanileria_armada_rejilla_o_bloques_sin_llenar", _MUROS,
+         "Albanileria armada - De ladrillos ceramicos tipo rejilla con y sin "
+         "relleno de huecos y albanileria de bloques de hormigon o unidades de "
+         "geometria similar en que no se llenan todos los huecos", 3.0, 3.0),
+    _row("otro", _OTRO,
+         "Cualquier tipo de estructuracion o material que no pueda ser "
+         "clasificado en alguna de las categorias anteriores", 2.0, None,
+         ("3",)),
+))
+
+
+def structural_system_keys() -> tuple[str, ...]:
+    """Lookup keys of Tabla 5.1, in printed order."""
+    return tuple(STRUCTURAL_SYSTEMS)
+
+
+def structural_system(system: str | StructuralSystem) -> StructuralSystem:
+    """Look a Tabla 5.1 row up by key.
+
+    Keys are matched case-insensitively and ignore surrounding whitespace. A
+    :class:`StructuralSystem` is returned unchanged, so callers can accept
+    either form.
+
+    Raises
+    ------
+    TableLookupError
+        ``system`` is not a row of Tabla 5.1.
+    """
+    if isinstance(system, StructuralSystem):
+        return system
+    key = str(system).strip().lower()
+    try:
+        return STRUCTURAL_SYSTEMS[key]
+    except KeyError:
+        raise TableLookupError(
+            f"structural system {system!r} is not defined in "
+            f"{_TABLE_REF}. Defined: {list(STRUCTURAL_SYSTEMS)}."
+        ) from None
+
+
+def _resolve(
+    name: str,
+    value: float | None,
+    system: str | StructuralSystem | None,
+    limit_of: Callable[[StructuralSystem], float],
+) -> float:
+    if value is not None and value <= 0.0:
+        raise InvalidInput(f"{name} must be positive.")
+    if system is None:
+        if value is None:
+            raise InvalidInput(
+                f"Supply {name} directly, or a structural system so it can be "
+                "taken from NCh433 Tabla 5.1."
+            )
+        return value
+    row = structural_system(system)
+    limit = limit_of(row)
+    if value is None:
+        return limit
+    if value > limit:
+        raise InvalidInput(
+            f"{name} = {value:g} exceeds the maximum of {limit:g} that NCh433 "
+            f"Tabla 5.1 gives for {row.key!r} ({row.label})."
+        )
+    return value
+
+
+def check_R(R: float | None, system: str | StructuralSystem | None) -> float:
+    """Resolve ``R`` from an explicit value, a Tabla 5.1 row, or both.
+
+    With both, the explicit value is used but must not exceed the tabulated
+    maximum — Tabla 5.1 prints *valores maximos* (§5.7.1), so a smaller factor
+    is always admissible and a larger one never is.
+    """
+    return _resolve("R", R, system, lambda row: row.R)
+
+
+def check_Ro(Ro: float | None, system: str | StructuralSystem | None) -> float:
+    """Resolve ``Ro`` the same way :func:`check_R` resolves ``R``."""
+    return _resolve("Ro", Ro, system, lambda row: row.require_Ro())
