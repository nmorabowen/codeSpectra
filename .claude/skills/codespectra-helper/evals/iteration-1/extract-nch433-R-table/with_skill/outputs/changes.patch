+class TestTabla51:
+    """Every cell of Tabla 5.1, pinned against the printed table."""
+
+    @pytest.mark.parametrize(("key", "R", "Ro"), TABLA_5_1)
+    def test_cell(self, key: str, R: float, Ro: float | None) -> None:
+        row = structural_system(key)
+        assert row.R == pytest.approx(R), f"Tabla 5.1 R for {key}"
+        if Ro is None:
+            assert row.Ro is None, f"Tabla 5.1 establishes no Ro for {key}"
+        else:
+            assert row.Ro == pytest.approx(Ro), f"Tabla 5.1 Ro for {key}"
+
+    def test_row_count(self) -> None:
+        assert len(STRUCTURAL_SYSTEMS) == len(TABLA_5_1)
+
+    def test_printed_order_preserved(self) -> None:
+        assert structural_system_keys() == tuple(k for k, _, _ in TABLA_5_1)
+
+    def test_keys_are_ascii_identifiers(self) -> None:
+        for key in structural_system_keys():
+            assert key.isascii() and key.isidentifier() and key.islower(), key
+
