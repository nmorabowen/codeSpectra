diff --git a/tests/test_asce7.py b/tests/test_asce7.py
index 9c49e48..567401c 100644
--- a/tests/test_asce7.py
+++ b/tests/test_asce7.py
@@ -337,6 +337,39 @@ class TestASCE722:
         site = ASCE7_22.from_site_adjusted(SMS=1.5, SM1=1.02, site_class="CD")
         assert any("Exception 2" in n for n in site.report().notes)
 
+    def test_ss_s1_alone_is_rejected_not_silently_zero(self) -> None:
+        """The 7-16-shaped call must fail loudly: 7-22 deleted Fa/Fv."""
+        with pytest.raises(InvalidInput) as excinfo:
+            ASCE7_22(Ss=1.5, S1=0.6, site_class="D")
+        message = str(excinfo.value)
+        assert "no Fa/Fv site coefficients" in message
+        # The message must name both supported constructors.
+        assert "from_mprs" in message
+        assert "from_site_adjusted" in message
+
+    def test_bare_construction_is_rejected(self) -> None:
+        with pytest.raises(InvalidInput, match="site-adjusted"):
+            ASCE7_22()
+
+    def test_ss_s1_retained_as_reporting_metadata(self) -> None:
+        """Supplied alongside SMS/SM1 they are recorded, and drive the SDC."""
+        site = ASCE7_22.from_site_adjusted(
+            SMS=1.5, SM1=1.02, site_class="CD", Ss=1.8, S1=0.8
+        )
+        assert site.report()["Ss"] == pytest.approx(1.8)
+        # S1 >= 0.75 triggers the §11.6 override.
+        assert site.seismic_design_category is SeismicDesignCategory.E
+        assert not any("S1 was not supplied" in n for n in site.report().notes)
+
+    def test_asce7_16_handoff_is_the_documented_escape_hatch(self) -> None:
+        """7-16 coefficients can be borrowed, but only by saying so explicitly."""
+        s16 = ASCE7_16(Ss=1.5, S1=0.6, site_class="D", TL=8.0)
+        s22 = ASCE7_22.from_site_adjusted(
+            SMS=s16.SMS, SM1=s16.SM1, site_class="D", TL=8.0
+        )
+        assert s22.SDS == pytest.approx(s16.SDS)
+        assert s22.SD1 == pytest.approx(s16.SD1)
+
 
