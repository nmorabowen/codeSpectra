diff --git a/tests/test_asce7.py b/tests/test_asce7.py
index 9c49e48..eb1d1d2 100644
--- a/tests/test_asce7.py
+++ b/tests/test_asce7.py
@@ -288,6 +288,32 @@ class TestASCE722:

         assert site.basis is SpectrumBasis.TWO_PERIOD

+    def test_no_site_coefficients_in_7_22(self) -> None:
+        """7-22 deleted Fa/Fv; SMS/SM1 come from the geodatabase (§11.4.3).
+
+        Commentary C11.4.3: SMS and SM1 incorporate site effects themselves,
+        "eliminating the need for the tables of site factors Fa and Fv of
+        ASCE 7-16". Neither `Table 11.4-1` nor `Table 11.4-2` exists in 7-22.
+        Re-adding either here would produce a mixed-edition number that no
+        clause authorises, so this pins their absence.
+        """
+        site = ASCE7_22.from_site_adjusted(SMS=1.5, SM1=1.02, site_class="CD")
+        for removed in ("Fa", "Fv", "Fa_override", "Fv_override"):
+            assert not hasattr(site, removed), (
+                f"ASCE 7-22 has no {removed}: §11.4.3 reads SMS/SM1 directly "
+                "from the USGS Seismic Design Geodatabase."
+            )
+
+    def test_Ss_S1_are_metadata_only(self) -> None:
+        """Ss/S1 are recorded and drive §11.6, but scale nothing (§11.4.3)."""
+        without = ASCE7_22.from_site_adjusted(SMS=1.5, SM1=1.02, site_class="CD")
+        with_mapped = ASCE7_22.from_site_adjusted(
+            SMS=1.5, SM1=1.02, site_class="CD", Ss=1.5, S1=0.6
+        )
+        assert with_mapped.SDS == pytest.approx(without.SDS)
+        assert with_mapped.SD1 == pytest.approx(without.SD1)
+        assert with_mapped.report()["Ss"] == pytest.approx(1.5)
+
     def test_expanded_site_classes_accepted(self) -> None:
         for sc in ("BC", "CD", "DE"):
             site = ASCE7_22.from_site_adjusted(SMS=1.0, SM1=0.5, site_class=sc)
